@page
@model StudentRazorPages.Pages.Groups.Create
@{
    ViewData["Title"] = "Добавить группу";
}

<h2 class="mb-3">Добавить новую группу</h2>

<div class="row">
    <div class="col-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label">Название группы</label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.StudyProgramId" class="form-label">Направление подготовки</label>
                <select asp-for="Input.StudyProgramId" asp-items="Model.StudyProgramList" class="form-select">
                    <option value="">-- Выберите направление --</option>
                </select>
                <span asp-validation-for="Input.StudyProgramId" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-success">Создать</button>
                <a asp-page="./Index" class="btn btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="Shared/_ValidationScriptsPartial" />
}