@page
@model StudentRazorPages.Pages.Groups.Index
@{
    ViewData["Title"] = "Список групп";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Список групп</h2>
    <a asp-page="./Create" class="btn btn-primary">+ Добавить группу</a>
</div>

@if (!string.IsNullOrEmpty(Model.DeleteErrorMessage))
{
    <p class="alert alert-danger">@Model.DeleteErrorMessage</p>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input asp-for="SearchTerm" class="form-control" placeholder="Поиск по названию..." />
        <span asp-validation-for="SearchTerm" class="text-danger"></span>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary">Найти</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Сбросить</a>
    </div>
</form>

<p class="text-muted">@Model.TotalCountMessage</p>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Направление</th>
            <th class="text-end">Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var group in Model.Groups)
        {
            <partial name="_GroupRow" model="group" />
        }
    </tbody>
</table>

@section Scripts {
    <partial name="Shared/_ValidationScriptsPartial" />
}